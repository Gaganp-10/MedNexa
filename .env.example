# ─────────────────────────────────────────────────────────────────────────────
# MEDIC Backend — Environment Variables
# Copy this file to .env and fill in real values before running in production.
# .env is gitignored and must NEVER be committed to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Django secret key — generate a new one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-new-secret-key-here-generate-one-never-commit-a-real-key

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hosts in production (e.g. your domain or IP)
# In production: ALLOWED_HOSTS=medic.example.com,api.medic.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL database URL (leave blank to use SQLite in dev)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
# Example: DATABASE_URL=postgres://medic_user:password@localhost:5432/medic_db
DATABASE_URL=

# Redis URL for Channels WebSocket channel layer (leave blank to use InMemoryChannelLayer in dev)
# Example: REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# CORS: comma-separated list of allowed frontend origins.
# Dev defaults include common Lovable/Vite preview ports.
# In production add the actual Lovable domain:
#   CORS_ALLOWED_ORIGINS=https://yourapp.lovableproject.com,https://medic.example.com
# NOTE: Also add the frontend domain to ALLOWED_HOSTS so WebSocket AllowedHostsOriginValidator passes.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# CSRF trusted origins (should match CORS_ALLOWED_ORIGINS for cookie-based flows)
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
